{
  "name": "cybersite",
  "productName": "CyberSite",
  "version": "1.1.0",
  "description": "Бот статусов и гостей для severeclaw.github.io",
  "author": "SevereClaw",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish always"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.severeclaw.cybersite",
    "productName": "CyberSite",
    "files": ["main.js", "preload.js", "bot.js", "ui/**", "build/icon.png", "build/tray.png", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "CyberSite-Setup-${version}.${ext}",
      "shortcutName": "CyberSite",
      "deleteAppDataOnUninstall": false
    },
    "publish": { "provider": "github", "owner": "SevereClaw", "repo": "CyberSite", "releaseType": "release" }
  }
}
